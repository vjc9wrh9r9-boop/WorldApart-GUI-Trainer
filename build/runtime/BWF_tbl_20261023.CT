                <CheatEntry>
      <ID>1428</ID>
      <Description>"激活修改"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>FF00FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
LuaCall(function cycleFullCompact(sender,force)     local state = not(compactmenuitem.Caption == '返回紧凑界面'); if force~=nil then state = not force end; compactmenuitem.Caption = state and '返回紧凑界面' or '返回原始界面'; getMainForm().Splitter1.Visible = state; getMainForm().Panel4.Visible    = state; getMainForm().Panel5.Visible    = state; end; function addCompactMenu() if compactmenualreadyexists then return end; local parent = getMainForm().Menu.Items; compactmenuitem = createMenuItem(parent); parent.add(compactmenuitem); compactmenuitem.Caption = '返回紧凑界面'; compactmenuitem.OnClick = cycleFullCompact; compactmenualreadyexists = 'yes'; end; addCompactMenu(); cycleFullCompact(nil,true))
{$lua}
if syntaxcheck then return end
processName = 'WorldApart.exe'
if not readInteger(processName) then
    openProcess(processName)
end
if not readInteger(processName) then
    messageDialog('请先开启游戏再进行激活~~')
    local t = createTimer()
    t.Interval = 200
    t.OnTimer = function(t)
    t.destroy()
    memrec.Active = false
    end
end
{$asm}
[DISABLE]
LuaCall(cycleFullCompact(nil,false))


</AssemblerScript>
